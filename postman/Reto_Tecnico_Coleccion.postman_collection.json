					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 400 (Rechazado)\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Pedido RECHAZADO y reserva RELEASED\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"RECHAZADO\");",
									"    pm.expect(jsonData.reservation.status).to.eql(\"RELEASED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
