		{
			"name": "Caso 1 - Flujo Exitoso",
			"item": [
				{
					"name": "1. Crear Pedido (Pago Aprobado)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Pedido queda en estado PAGADO\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"PAGADO\");",
									"    pm.expect(jsonData.reservation.status).to.eql(\"COMMITTED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Idempotency-Key",
								"value": "CLAVE-PRUEBA-CASO-1",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": \"PROD-001\",\n    \"quantity\": 1,\n    \"simulation_mode\": \"APPROVE\"\n}"
						},
						"url": {
							"raw": "{{order_api_url}}/orders",
							"host": ["{{order_api_url}}"],
							"path": ["orders"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Caso 2 - Repetición de la Misma Solicitud",
			"item": [
				{
					"name": "2. Reenviar Pedido con Misma Clave (Idempotencia)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (Replay Idempotente)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Reconocido como replay y mismo pedido devuelto\", function () {",
									"    pm.expect(jsonData.idempotent_replay).to.eql(true);",
									"    pm.expect(jsonData.order.status).to.eql(\"PAGADO\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Idempotency-Key",
								"value": "CLAVE-PRUEBA-CASO-1",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": \"PROD-001\",\n    \"quantity\": 1,\n    \"simulation_mode\": \"APPROVE\"\n}"
						},
						"url": {
							"raw": "{{order_api_url}}/orders",
							"host": ["{{order_api_url}}"],
							"path": ["orders"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Caso 3 - Timeout tras Cobro y Recuperación",
			"item": [
				{
					"name": "3.1 Crear Pedido (Timeout simulado tras cobrar)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 504 (Timeout)\", function () {",
									"    pm.response.to.have.status(504);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Pedido en PAGO_INCIERTO\", function () {",
									"    pm.expect(jsonData.status).to.eql(\"PAGO_INCIERTO\");",
									"    pm.environment.set(\"caso3_order_id\", jsonData.order_id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Idempotency-Key",
								"value": "CLAVE-PRUEBA-CASO-3",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": \"PROD-001\",\n    \"quantity\": 1,\n    \"simulation_mode\": \"TIMEOUT_AFTER_CHARGE\"\n}"
						},
						"url": {
							"raw": "{{order_api_url}}/orders",
							"host": ["{{order_api_url}}"],
							"path": ["orders"]
						}
					},
					"response": []
				},
				{
					"name": "3.2 Inspeccionar Mock (Cobro guardado en Mock)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El pago fue efectivamente registrado en Mock como APPROVED\", function () {",
									"    pm.response.to.have.status(200);",
									"    var data = pm.response.json();",
									"    pm.expect(data.status).to.eql(\"APPROVED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{payment_api_url}}/payments/CLAVE-PRUEBA-CASO-3",
							"host": ["{{payment_api_url}}"],
							"path": ["payments", "CLAVE-PRUEBA-CASO-3"]
						}
					},
					"response": []
				},
				{
					"name": "3.3 Recuperar / Reconciliar Pedido Incierto",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Reconciliación exitosa pasa a PAGADO sin duplicar cobro\", function () {",
									"    pm.response.to.have.status(200);",
									"    var data = pm.response.json();",
									"    pm.expect(data.order.status).to.eql(\"PAGADO\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{order_api_url}}/orders/{{caso3_order_id}}/reconcile",
							"host": ["{{order_api_url}}"],
							"path": ["orders", "{{caso3_order_id}}", "reconcile"]
						}
					},
					"response": []
				}
			]
		},
		{
